{
  "name": "bsl-console",
  "version": "1.0.0",
  "description": "",
  "main": "editor.js",
  "homepage": "https://github.com/salexdv/bsl_console",
  "scripts": {
    "test": "npm run test:formatter && npm run test:search-history && npm run test:query-model-corpus && npm run test:query-navigation && npm run test:query-model-service && npm run test:help",
    "test:formatter": "mocha tests/bsl_formatter_test.js",
    "test:search-history": "node tests/search_history_test.js",
    "build:headless": "webpack --mode development --progress",
    "test:headless": "node tools/run_search_history_headless.js",
    "test:query-model-corpus": "node tests/query_model_corpus_test.js --strict-errors --strict-structure",
    "test:query-navigation": "node tests/query_navigation_test.js",
    "test:query-model-service": "node tests/query_model_service_test.js",
    "debug": "webpack-dev-server --mode development --progress",
    "build": "webpack --mode production --progress",
    "escheck": "es-check es2015 \"dist/*.js\"",
    "build:single": "webpack --mode production --env single --progress && node tools/check_single.js",
    "build:pack": "webpack --mode production --env single --env pack --progress && node tools/make_pack.js && node tools/check_single.js",
    "test:help": "node tests/help_test.js",
    "test:help:headless": "node tools/run_help_headless.js",
    "smoke:help": "node tools/smoke_help_hbk.js",
    "build:test": "webpack --mode development --env test --progress",
    "test:mocha": "node tools/run_mocha_headless.js",
    "check:workers": "node tools/check_blob_workers.js",
    "check:single": "node tools/check_single.js"
  },
  "author": "Shkuraev Alexander",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "diff": "9.0.0",
    "glob": "13.0.6",
    "minimatch": "10.2.6",
    "serialize-javascript": "7.0.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "chai": "^6.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "acorn": "^8.16.0",
    "css-loader": "^7.1.4",
    "es-check": "^9.6.4",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.8",
    "mocha": "^11.7.6",
    "pako": "^3.0.1",
    "postcss": "^8.5.25",
    "postcss-loader": "^8.2.1",
    "puppeteer-core": "^24.43.1",
    "string-replace-loader": "^3.3.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "monaco-editor": "0.20.0",
    "monaco-editor-nls": "2.0.0"
  }
}
